DATABASE_URL=postgresql://postgres:postgres@localhost:55440/weatherwise_development
CORS_ORIGINS=http://localhost:3000,http://localhost:8080,http://127.0.0.1:8080
GEOCODING_PROVIDER=open_meteo
WEATHER_PROVIDER=open_meteo
TRIP_HOURLY_TIMEOUT_SECONDS=8
GEOCODING_LANGUAGE=en
FORECAST_CACHE_TTL_MINUTES=60
HOURLY_FORECAST_CACHE_TTL_MINUTES=60

# Location-specific hero photography. Wikimedia uses freely licensed page
# imagery and requires no API key. Misses are cached to avoid repeated lookups.
LOCATION_IMAGE_PROVIDER=wikimedia
LOCATION_IMAGE_CACHE_TTL_DAYS=30

# Background refresh eligibility. A location is considered popular after this
# many forecast requests inside the rolling lookback window.
POPULAR_FORECAST_MIN_REQUESTS=3
POPULAR_FORECAST_LOOKBACK_DAYS=2

# Nearby activity discovery. Set to database for seeded/offline-only results.
ACTIVITY_PROVIDERS=auto
OVERPASS_API_URL=https://overpass.private.coffee/api/interpreter
OVERPASS_API_URLS=https://overpass.private.coffee/api/interpreter,https://overpass-api.de/api/interpreter
ACTIVITY_RADIUS_METERS=50000
PROVIDER_CONTACT=you@example.com
RECOMMENDATION_CACHE_TTL_MINUTES=360

# Optional on-demand activity-hours verification. Google Places current hours
# cover today plus the next six days and may incur usage charges.
ACTIVITY_AVAILABILITY_PROVIDER=unavailable
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACES_API_URL=https://places.googleapis.com/v1/places:searchText
GOOGLE_PLACES_LANGUAGE=en

# Restaurant discovery for trip meals. In auto mode it uses the same Google
# Places key when present. Only venues rated at least 4.0 with 10+ reviews are
# accepted; missing credentials produce explicit unfilled meal slots.
DINING_PROVIDER=auto

# Point-to-point travel times for each itinerary stop. Enable the Google Routes
# API for this server-side key. Without it, plans clearly show the rhythm buffer
# as an estimate instead of presenting it as a calculated route.
ROUTING_PROVIDER=auto
GOOGLE_ROUTES_API_KEY=
GOOGLE_ROUTES_API_URL=https://routes.googleapis.com/directions/v2:computeRoutes
ROUTE_CACHE_TTL_HOURS=24

# Movie discovery is opt-in. In auto mode it activates as soon as a TMDB API
# read access token is present. The token remains on the Rails server.
MOVIE_PROVIDER=auto
TMDB_BEARER_TOKEN=
# Cache a broader catalog so fourteen-day and cross-location rotation can avoid
# repeats. Valid range: 1-5 TMDB discovery pages (20 titles per page).
MOVIE_CATALOG_PAGES=3
# Fallback only; interface requests select en-US or ro-RO dynamically.
MOVIE_LANGUAGE=en-US

# Auto-enables every configured live event source and merges their results.
# Or select an explicit comma-separated list, e.g. ticketmaster,predicthq.
EVENT_PROVIDERS=auto
TICKETMASTER_API_KEY=
EVENT_RADIUS_KM=25
PREDICTHQ_ACCESS_TOKEN=
PREDICTHQ_RADIUS_KM=25

# Cinema showtimes are opt-in and require territory-specific MovieGlu access.
# Showtime responses are requested live and are not persisted by WeatherWise.
SHOWTIME_PROVIDER=database
MOVIEGLU_API_URL=https://api-gate2.movieglu.com/
MOVIEGLU_CLIENT=
MOVIEGLU_API_KEY=
MOVIEGLU_AUTHORIZATION=
MOVIEGLU_TERRITORY=
MOVIEGLU_API_VERSION=v200

# Reserved for future commercial or alternative providers. Open-Meteo's
# non-commercial public endpoints do not require keys.
GEOCODING_API_KEY=
WEATHER_API_KEY=
